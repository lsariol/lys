# Copy to .env for a local run. Secrets come from your dev Cove, never from here.
APP_ENV="DEV"
COVE_URL="http://localhost:2110"
COVE_TOKEN="Lys' token from your dev Cove (token create lys --allow 'LYS_*' --write LYS_TWITCH_ACCESS_TOKEN --write LYS_TWITCH_REFRESH_TOKEN)"
NOTIFICATION_PORT="8080"
# Optional: without them the inlet and the enrollment API refuse every request.
SHARED_LYS_NOTIFICATION_TOKEN=""
SHARED_LYS_ENROLLMENT_TOKEN=""
